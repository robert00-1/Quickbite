# Local development. Use APP_ENV=production and COOKIE_SECURE=true behind HTTPS.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_SECRET_KEY=replace-with-another-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://quickbite:replace-password@localhost:5432/quickbite
FRONTEND_ORIGIN=http://localhost:5173
# Optional additional exact frontend origins, comma-separated (especially production).
FRONTEND_ORIGINS=
COOKIE_SECURE=false
FLASK_DEBUG=false
# Backend origin; must be public HTTPS for WhatsApp QR images/receipt links.
PUBLIC_API_URL=http://localhost:5000

# Safaricom Daraja app credentials. Sandbox and production have different credentials.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-public-api.example/api/mpesa/callback
# Generate a long URL-safe random secret; appended to callbacks, redacted from app logs.
DARAJA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional KSh 1 testing; rejected in production. Defaults to the actual order total.
MPESA_FORCE_1_KSH=false

# Official Meta WhatsApp Business Cloud API; approved utility template required.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Existing manager image upload integration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Approved order event utility template: body parameters {{1}} order ID, {{2}} status.
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional WABA identifier for setup/subscription checks; not needed to send messages.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Original MealDB catalogue. Key 1 is the provider's public educational/test key.
MEALDB_ENABLED=true
MEALDB_API_KEY=1
MEALDB_CACHE_SECONDS=3600
